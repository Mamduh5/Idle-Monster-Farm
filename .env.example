# Create .env from this file for local overrides.
#
# Local browser and debug builds use mock rewarded ads by default.
VITE_ADS_PROVIDER=mock

# Set this to admob only for Android native AdMob testing or release builds.
# VITE_ADS_PROVIDER=admob

# Optional testing flag for AdMob SDK initialization and rewarded requests.
VITE_ADMOB_TESTING=true

# Android rewarded ad unit IDs. Use Google's rewarded test ID while testing.
# Production IDs must come from the app owner's AdMob account.
# VITE_ADMOB_REWARDED_DEFAULT_ANDROID=ca-app-pub-3940256099942544/5224354917
# VITE_ADMOB_REWARDED_SAFE_RITUAL_ANDROID=ca-app-pub-3940256099942544/5224354917
# VITE_ADMOB_REWARDED_BOSS_REVIVE_ANDROID=ca-app-pub-3940256099942544/5224354917
# VITE_ADMOB_REWARDED_BOSS_FIRST_CLEAR_X2_ANDROID=ca-app-pub-3940256099942544/5224354917
# VITE_ADMOB_REWARDED_BOSS_AUTO_CLEAR_X2_ANDROID=ca-app-pub-3940256099942544/5224354917

# Android AdMob app ID for native metadata. The committed Android default is
# Google's official test app ID; production IDs must not be committed.
VITE_ADMOB_APP_ID_ANDROID=
